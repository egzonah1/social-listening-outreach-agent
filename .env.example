# Copy this file to .env and fill in real values. .env is git-ignored.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Database (local Postgres from docker compose; Neon in production) ---
DATABASE_URL=postgresql+psycopg://outreach:outreach@localhost:5433/outreach

# --- AI ---
# gemini (default, free tier, no card), anthropic (paid), or rules (no AI at all)
AI_PROVIDER=gemini
# If the AI fails (e.g. the free daily limit is used up), use keyword rules instead
AI_FALLBACK_TO_RULES=true

# Free key from Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Fastest free models in our speed test (Nov 26); backups are tried in order
GEMINI_DRAFT_MODEL=gemini-3.5-flash-lite
GEMINI_TRIAGE_MODEL=gemini-3.5-flash-lite
GEMINI_DRAFT_BACKUP_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash
GEMINI_TRIAGE_BACKUP_MODELS=gemini-3.1-flash-lite
# No waiting: hard time limit per AI call (then backup model or rules), and how
# many replies are written in the background right after each search
AI_TIME_BUDGET_SECONDS=45
PREDRAFT_LIMIT=8

# Only needed with AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
CLAUDE_DRAFT_MODEL=claude-opus-5-5
CLAUDE_TRIAGE_MODEL=claude-haiku-5-5

# --- Bluesky (use a dedicated account and an app password, never your main password) ---
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=

# --- Mastodon (no account needed: public hashtag timelines from this server) ---
MASTODON_INSTANCE=https://mastodon.social

# Data protection: shown in the app footer; posts are deleted after this many days
CONTACT_EMAIL=
RETENTION_DAYS=30

# --- Public demo protection ---
# Set an access code on the live app so only people you send it to can use it.
# Leave empty on your own computer.
ACCESS_CODE=
# Usage limits (0 switches a limit off): searches and AI actions per visitor
# per hour, and in total per day, so nobody can use up the free AI quota
SEARCHES_PER_HOUR=10
SEARCHES_PER_DAY_TOTAL=100
AI_ACTIONS_PER_HOUR=60
AI_ACTIONS_PER_DAY_TOTAL=400
